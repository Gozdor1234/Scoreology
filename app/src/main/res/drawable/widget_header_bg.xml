<?xml version="1.0" encoding="utf-8"?>
<!--
  Frosted-glass header: a see-through tint (the wallpaper shows through) colored from the
  wallpaper's palette on Android 12+, with a soft light sheen at the top and a hairline edge.
  Android doesn't let app widgets blur what's behind them, so this is tint, not blur.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_tint" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
